# ======================
# NAGARPAALAN AI — Environment Configuration
# ======================
# Copy this file to .env and update values as needed.

# Application
APP_NAME=NAGARPAALAN AI
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nagarpaalan
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nagarpaalan_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
